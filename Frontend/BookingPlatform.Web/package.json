{
  "name": "booking-platform-web",
  "version": "0.1.0",
  "description": "Booking Platform staff dashboard and public booking web application",
  "productName": "Booking Platform",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "lint": "eslint --max-warnings 0 -c ./eslint.config.js \"./src/**/*.{js,vue}\" \"./test/**/*.js\" \"./*.js\"",
    "format": "prettier --write \"**/*.{js,vue,css,html,json}\" --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,vue,css,html,json}\" --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@quasar/extras": "^2.1.0",
    "axios": "^1.20.0",
    "pinia": "^4.0.3",
    "quasar": "^2.34.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.10.1",
    "@quasar/vite-plugin": "^2.0.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^24 || ^22.22.0"
  }
}
