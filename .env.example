# Copy to .env (git-ignored) and replace every CHANGE_ME value. Never commit real secrets.

# --- Docker Compose: PostgreSQL ---
POSTGRES_DB=bookingplatform
POSTGRES_USER=bookingplatform
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_PORT=5432

# --- Docker Compose: Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_PORT=6379

# --- Docker Compose: Mailpit (development email inbox at http://localhost:8025) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- .NET hosts (Api, Worker, Migrations) ---
# scripts/dev-secrets.ps1 / scripts/dev-secrets.sh copy these into .NET user-secrets for local development.
# In deployed environments, supply them as environment variables from the platform secret store.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=bookingplatform;Username=bookingplatform;Password=CHANGE_ME_postgres_password
ConnectionStrings__Redis=localhost:6379,password=CHANGE_ME_redis_password,abortConnect=false

# One origin per key; add more with Cors__AllowedOrigins__1, Cors__AllowedOrigins__2, ...
Cors__AllowedOrigins__0=http://localhost:9000

# HMAC-SHA256 key for access tokens: at least 32 random bytes, for example
#   PowerShell 7: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
#   bash:       openssl rand -base64 48
Jwt__SigningKey=CHANGE_ME_generate_a_random_key_of_at_least_32_bytes

# HMAC key for guest manage-booking links (separate from the JWT key; generate the same way). Rotating it invalidates
# links in emails already sent.
PublicBooking__TokenKey=CHANGE_ME_generate_another_random_key_of_at_least_32_bytes

# Worker email settings. Development defaults (appsettings.Development.json) send to Mailpit; production needs an SMTP
# relay. Set these only to override, e.g. Notifications__Email__SmtpHost, Notifications__Email__SmtpPassword (secret).
# Notifications__PublicBaseUrl=http://localhost:9000
# Notifications__Email__FromAddress=no-reply@bookingplatform.local

# --- Development seed (Migrations seed-dev; refused in Production) ---
# Demo users (admin, manager, host, staff, viewer @ the admin's domain) all get this password.
DEV_ADMIN_EMAIL=admin@demo.local
DEV_ADMIN_PASSWORD=CHANGE_ME_dev_admin_password

# --- Frontend (build time) ---
# Defaults to /api, which the Quasar dev server proxies to http://localhost:5080.
VITE_API_BASE_URL=/api
