# Copy the values you need into the environment before running the demo scripts.
# Never commit real passwords. These scripts talk to a local Development API only.

# Platform admin created by `dotnet run --launch-profile seed-dev`.
DEV_ADMIN_EMAIL=admin@demo.local
DEV_ADMIN_PASSWORD=replace-with-local-dev-password

# Local API (the Quasar dev server proxies the browser; the seed script calls the API directly).
DEMO_API_BASE=http://localhost:5080
DEMO_WEB_BASE=http://localhost:9000
