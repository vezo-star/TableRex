# Copy to deploy/.env (git-ignored) and replace every CHANGE_ME value. Never commit real secrets.
# Generate keys with:  openssl rand -base64 48   (or PowerShell 7+: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48)))
# For APP_DB_PASSWORD use a value without spaces, e.g.  openssl rand -hex 24

# Local builds use bookingplatform/<service>:local. To run CI-built images, set IMAGE_REGISTRY to
# $CI_REGISTRY_IMAGE (for example registry.gitlab.com/acme/booking-platform) and IMAGE_TAG to a commit SHA or tag.
IMAGE_REGISTRY=bookingplatform
IMAGE_TAG=local
HTTP_BIND=127.0.0.1
HTTP_PORT=8088

# Origin users open in the browser (https in production). Used for CORS, email links and payment return URLs.
PUBLIC_BASE_URL=http://localhost:8088

POSTGRES_DB=bookingplatform
POSTGRES_USER=bookingplatform
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
# Least-privilege role for the Api and Worker, created/updated by the migrator on every deploy.
# 16-128 printable ASCII characters without spaces; changing it and redeploying rotates it.
APP_DB_USER=bookingplatform_app
APP_DB_PASSWORD=CHANGE_ME_app_database_password
REDIS_PASSWORD=CHANGE_ME_redis_password

JWT_SIGNING_KEY=CHANGE_ME_generate_a_random_key_of_at_least_32_bytes
PUBLIC_BOOKING_TOKEN_KEY=CHANGE_ME_generate_another_random_key_of_at_least_32_bytes

# Empty = online payments off (deposit venues refuse online bookings). Leave empty until a real provider adapter exists.
PAYMENTS_PROVIDER=

# Email: Log (delivers nothing), Smtp (relay) or Pickup.
MAIL_PROVIDER=Log
MAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=

# Used once by: docker compose -f deploy/compose.yml --env-file deploy/.env run --rm migrator bootstrap-admin
# Remove the password from this file afterwards.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Platform Admin
