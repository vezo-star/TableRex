{
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "AutoMigrate": false
  },
  "Jwt": {
    "Issuer": "booking-platform",
    "Audience": "booking-platform-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "PublicBooking": {
    "TokenKey": "",
    "MaxActiveBookingsPerContact": 3
  },
  "Auth": {
    "RefreshTokenDays": 14,
    "RefreshTokenAbsoluteDays": 30,
    "LockoutThreshold": 5,
    "LockoutBaseMinutes": 1,
    "LockoutMaxMinutes": 60
  },
  "ReverseProxy": {
    "TrustedNetworks": []
  },
  "AllowedHosts": "*",
  "LogFormat": "json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.SignalR.Internal.DefaultHubDispatcher": "Fatal",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning",
        "Npgsql": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Properties": {
      "Application": "BookingPlatform.Api"
    }
  }
}
